# nSpeech Service Configuration

# ── Default Engine ──────────────────────────────────────────────────────────
# The engine loaded on startup. Kokoro is the default — it's CPU-fast and
# needs no GPU. The Node server manages engine switching at runtime via
# the dashboard or POST /v1/admin/engine.
#
# Local engines: kokoro, chatterbox-turbo, chatterbox-eng,
#                chatterbox-mtl, dots
# Cloud engines: minimax, elevenlabs, gemini, xai (need API keys below)
NSPEECH_ENGINE=kokoro

# ── Server Bindings ─────────────────────────────────────────────────────────
NSPEECH_HOST=127.0.0.1
NSPEECH_PORT=2233

# ── Cloud Provider API Keys ─────────────────────────────────────────────────
# Cloud providers are always available in the dashboard but return errors
# until the corresponding key is set. Leave blank to disable a provider.
MINIMAX_API_KEY=
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
XAI_API_KEY=

# ── nVoice STT/Alignment Service (optional) ─────────────────────────────────
# Used for speech-to-text transcription and forced alignment.
# Separate project at https://github.com/badkid/nVoice
NVOICE_URL=https://127.0.0.1:2244

# ── Auth ────────────────────────────────────────────────────────────────────
# Leave blank for open access (local network)
NSPEECH_API_KEY=

# ── Lifecycle ───────────────────────────────────────────────────────────────
NSPEECH_PRELOAD_MODEL=false
NSPEECH_MODEL_IDLE_TIMEOUT_SEC=0
NSPEECH_LOG_LEVEL=INFO

# ── Transcoding ─────────────────────────────────────────────────────────────
NSPEECH_TRANSCODE_SAMPLE_RATE=24000
NSPEECH_TRANSCODE_BITRATE=128k

# ── Logging ─────────────────────────────────────────────────────────────────
NSPEECH_LOG_DIR=logs
