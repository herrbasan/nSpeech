{
  "kokoro": {
    "venv_python": "venv/kokoro/env/Scripts/python.exe",
    "worker_module": "nspeech.worker_server",
    "gpu": false
  },
  "stt": {
    "venv_python": "venv/stt/env/Scripts/python.exe",
    "worker_module": "nspeech.stt_worker",
    "gpu": false,
    "stt": true
  },
  "chatterbox-turbo": {
    "venv_python": "venv/chatterbox/env/Scripts/python.exe",
    "worker_module": "nspeech.worker_server",
    "gpu": true
  },
  "f5tts": {
    "venv_python": "venv/f5tts/env/Scripts/python.exe",
    "worker_module": "nspeech.worker_server",
    "gpu": true,
    "health_check_timeout_ms": 180000,
    "env": {
      "NSPEECH_F5_CKPT_DE": "venv/f5tts/models/F5-TTS-German/model_420000.safetensors"
    },
    "voice_scan": {
      "sidecar": ".f5tts.txt"
    }
  },
  "f5tts-german": {
    "venv_python": "venv/f5tts/env/Scripts/python.exe",
    "worker_module": "nspeech.worker_server",
    "gpu": true,
    "health_check_timeout_ms": 180000,
    "voice_dir": "venv/f5tts/voices",
    "model_dir": "venv/f5tts/models",
    "api_hidden": true,
    "env": {
      "NSPEECH_F5_MODEL": "F5TTS_Base",
      "NSPEECH_F5_CKPT": "venv/f5tts/models/F5-TTS-German/model_420000.safetensors"
    },
    "voice_scan": {
      "sidecar": ".f5tts.txt"
    }
  },
  "vibevoice": {
    "venv_python": "venv/vibevoice/env/Scripts/python.exe",
    "worker_module": "nspeech.worker_server",
    "gpu": true,
    "stream_timeout_ms": 600000,
    "health_check_timeout_ms": 300000
  }
}
